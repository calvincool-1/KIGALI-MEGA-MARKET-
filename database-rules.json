{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('userType').val() === 'admin'",
        ".validate": "newData.hasChildren(['uid', 'email', 'fullName', 'phone', 'userType', 'verified', 'createdAt'])"
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() === 'seller' || root.child('users').child(auth.uid).child('userType').val() === 'admin')",
        ".validate": "newData.hasChildren(['name', 'description', 'price', 'stock', 'category', 'sellerId', 'sellerName', 'status', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().matches(/^(electronics|fashion|food|home|beauty|other)$/)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected)$/)"
        }
      }
    },
    "orders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['buyerId', 'buyerName', 'items', 'total', 'status', 'createdAt'])",
        "buyerId": {
          ".validate": "newData.isString()"
        },
        "buyerName": {
          ".validate": "newData.isString()"
        },
        "items": {
          ".validate": "newData.hasChildren()"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed|preparing|ready|in_transit|delivered|cancelled)$/)"
        },
        "logisticsId": {
          ".validate": "newData.isString()"
        },
        "logisticsName": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
